M\">6</field></shadow></value><value name=\"y41c1k4znm8mr1gij9bb\"><shadow type=\"text\"><field name=\"TEXT\">+</field></shadow></value><next><block type=\"function_call\"><mutation name=\"WriteAt\" functionid=\";Fx}vXF!dSjaRR7|S+:w\"><arg name=\"Zeile\" id=\"6j5sd10uie18po09bggx\" type=\"number\"></arg><arg name=\"Spalte\" id=\"uhd3spcgcrerufalf9w0b\" type=\"number\"></arg><arg name=\"Text\" id=\"y41c1k4znm8mr1gij9bb\" type=\"string\"></arg></mutation><value name=\"6j5sd10uie18po09bggx\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"argument_reporter_number\"><field name=\"VALUE\">Zeile</field></block></value><value name=\"uhd3spcgcrerufalf9w0b\"><shadow type=\"math_number\"><field name=\"NUM\">7</field></shadow></value><value name=\"y41c1k4znm8mr1gij9bb\"><shadow type=\"text\"><field name=\"TEXT\">-</field></shadow></value><next><block type=\"function_call\"><mutation name=\"WriteAt\" functionid=\";Fx}vXF!dSjaRR7|S+:w\"><arg name=\"Zeile\" id=\"6j5sd10uie18po09bggx\" type=\"number\"></arg><arg name=\"Spalte\" id=\"uhd3spcgcrerufalf9w0b\" type=\"number\"></arg><arg name=\"Text\" id=\"y41c1k4znm8mr1gij9bb\" type=\"string\"></arg></mutation><value name=\"6j5sd10uie18po09bggx\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"argument_reporter_number\"><field name=\"VALUE\">Zeile</field></block></value><value name=\"uhd3spcgcrerufalf9w0b\"><shadow type=\"math_number\"><field name=\"NUM\">8</field></shadow></value><value name=\"y41c1k4znm8mr1gij9bb\"><shadow type=\"text\"><field name=\"TEXT\">+</field></shadow></value><next><block type=\"function_call\"><mutation name=\"WriteAt\" functionid=\";Fx}vXF!dSjaRR7|S+:w\"><arg name=\"Zeile\" id=\"6j5sd10uie18po09bggx\" type=\"number\"></arg><arg name=\"Spalte\" id=\"uhd3spcgcrerufalf9w0b\" type=\"number\"></arg><arg name=\"Text\" id=\"y41c1k4znm8mr1gij9bb\" type=\"string\"></arg></mutation><value name=\"6j5sd10uie18po09bggx\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"argument_reporter_number\"><field name=\"VALUE\">Zeile</field></block></value><value name=\"uhd3spcgcrerufalf9w0b\"><shadow type=\"math_number\"><field name=\"NUM\">9</field></shadow></value><value name=\"y41c1k4znm8mr1gij9bb\"><shadow type=\"text\"><field name=\"TEXT\">-</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block><block type=\"function_definition\" x=\"1585\" y=\"5280\"><mutation name=\"succ\" functionid=\"yMt%uy8Ehb%rD.FQzwJv\"><arg name=\"wert\" id=\"ynee57k0fobqof7ksszw\" type=\"number\"></arg></mutation><field name=\"function_name\">succ</field><value name=\"ynee57k0fobqof7ksszw\"><block type=\"argument_reporter_number\" deletable=\"false\"><field name=\"VALUE\">wert</field></block></value><statement name=\"STACK\"><block type=\"function_return\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" no_return_value=\"false\"></mutation><value name=\"RETURN_VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"math_arithmetic\"><field name=\"OP\">ADD</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"argument_reporter_number\"><field name=\"VALUE\">wert</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value></block></value></block></statement></block></xml>","main.ts":"","README.md":"\n> Diese Seite bei [https://phg-2025.github.io/ttt_mit_und_ohne/](https://phg-2025.github.io/ttt_mit_und_ohne/) öffnen\n\n## Als Erweiterung verwenden\n\nDieses Repository kann als **Erweiterung** in MakeCode hinzugefügt werden.\n\n* öffne [https://makecode.calliope.cc/](https://makecode.calliope.cc/)\n* klicke auf **Neues Projekt**\n* klicke auf **Erweiterungen** unter dem Zahnrad-Menü\n* nach **https://github.com/phg-2025/ttt_mit_und_ohne** suchen und importieren\n\n## Dieses Projekt bearbeiten\n\nUm dieses Repository in MakeCode zu bearbeiten.\n\n* öffne [https://makecode.calliope.cc/](https://makecode.calliope.cc/)\n* klicke auf **Importieren** und dann auf **Importiere URL**\n* füge **https://github.com/phg-2025/ttt_mit_und_ohne** ein und klicke auf Importieren\n\n#### Metadaten (verwendet für Suche, Rendering)\n\n* for PXT/calliopemini\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n","main.py":"\"\"\"\n\nDas Spiel TicTacToe (ohne MiniMax-Algorithmus)\n\nTaste A: Standard-Start: Spieler\n\nTaste A+B: Start Computer\n\nTaste A: Feldauswahl\n\nTaste B: Feld besetzen\n\nIn Kürze: http://www.prof-horst-guenther.de/calliope\n\n\"\"\"\n# Das Spiel TicTacToe\n# \n# Standard: Spieler startet. (O)\n# \n# Taste A+B: Calli startet   (X)\n# \n# Taste A: Zelle auswählen\n# \n# Taste B: Zelle setzen\n# \n# (näheres demnächst bei http://www.prof-horst-guenther.de/Calliope)\n# \n# Spiel kann mit und ohne OLED-Display gespielt werden.\ndef zeigeLED(nr: number):\n    ToKoord(nr)\n    basic.pause(500)\n    if Punkt == \"X\":\n        led.plot_brightness(sp_LED, zl_LED, 30)\n    else:\n        if Punkt == \"O\":\n            led.plot_brightness(sp_LED, zl_LED, 255)\ndef Zufall():\n    global akt\n    akt = randint(0, 8)\n    while B(akt) != 0:\n        akt = randint(0, 8)\n    Buche(akt)\n    zeigeZelle(akt)\n    basic.pause(1000)\ndef zeigeFeld():\n    Werte(3)\n    Strich(4)\n    Werte(5)\n    Strich(6)\n    Werte(7)\ndef blocke(nr2: number):\n    global i1\n    for sp in range(3):\n        i1 = Loesungen[nr2][sp]\n        if B(i1) == 0:\n            Buche(i1)\n            zeigeZelle(i1)\n            break\ndef ToKoord2(nr3: number):\n    global zl_SCR, zl_LED, sp_LED, sp_SCR\n    zl_SCR = zl_SCR + 3\n    zl_LED = zl_LED + 1\n    sp_LED = nr3 % 3\n    sp_SCR = sp_LED * 2\n    sp_SCR = sp_SCR + 5\n    sp_LED = sp_LED + 1\ndef E(i: number):\n    return Ecken[i]\ndef ToKoord(nr4: number):\n    global zl_LED, zl_SCR, sp_LED, sp_SCR\n    zl_LED = Math.floor(nr4 / 3)\n    zl_SCR = zl_LED * 2\n    zl_SCR = zl_SCR + 3\n    zl_LED = zl_LED + 1\n    sp_LED = nr4 % 3\n    sp_SCR = sp_LED * 2\n    sp_SCR = sp_SCR + 5\n    sp_LED = sp_LED + 1\ndef Buche(nr5: number):\n    global Fertig\n    if B(nr5) != 0:\n        music.play(music.tone_playable(262, music.beat(BeatFraction.WHOLE)),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(100)\n        music.play(music.tone_playable(262, music.beat(BeatFraction.WHOLE)),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.pause(100)\n    else:\n        Board[nr5] = 1\n        Fertig = True\ndef zeigeZelle(nr6: number):\n    global Punkt\n    if nr6 >= 0:\n        ToKoord(nr6)\n        if B(nr6) < 0:\n            Punkt = \"O\"\n        else:\n            if B(nr6) == 0:\n                Punkt = \" \"\n            else:\n                if B(nr6) == 1:\n                    Punkt = \"X\"\n                else:\n                    Punkt = \"O\"\n        basic.pause(500)\n        WriteAt(zl_SCR, sp_SCR, Punkt)\n        zeigeLED(nr6)\ndef setzeAufFreieEcke():\n    global e2\n    for l in range(4):\n        e2 = E(l)\n        if B(e2) == 0:\n            Buche(e2)\n            zeigeZelle(e2)\n            return True\n    return False\n\ndef on_button_a():\n    global Punkt, blinke, akt\n    if Ende:\n        Brumme()\n    else:\n        Punkt = \"O\"\n        WriteAt(0, 0, \"Taste A wählt  \")\n        WriteAt(1, 0, \"Taste B setzt  \")\n        if akt >= 0:\n            loescheLED(akt)\n            Board[akt] = 0\n            WriteAt(zl_SCR, sp_SCR, \" \")\n        blinke = True\n        akt += 1\n        akt = akt % 9\n        while B(akt) > 0:\n            akt += 1\n            akt = akt % 9\n        Board[akt] = -1\n        zeigeZelle(akt)\ninput.on_button_event(Button.A, input.button_event_click(), on_button_a)\n\ndef Brumme():\n    music.play(music.tone_playable(131, music.beat(BeatFraction.WHOLE)),\n        music.PlaybackMode.UNTIL_DONE)\ndef leere(zl: number):\n    oledssd1306.set_text_xy(zl, 0)\n    oledssd1306.clear_range(16)\ndef succ(wert: number):\n    return wert + 1\ndef blockieren():\n    for bl in range(8):\n        if summe(bl) == 2:\n            blocke(bl)\n            return bl\n    return -1\ndef ComputerHatBegonnen():\n    if Zug == 1:\n        if hatGesetzt == MITTE:\n            setzeAufEckeGegenueber()\n        else:\n            if hatGesetzt == ECKE:\n                setzeAufFreieEcke()\n            else:\n                setzeAufFreieEcke()\n    else:\n        pass\n\ndef on_button_ab():\n    global ComputerStartete, Zug, hatGesetzt, e, Ecke1\n    leere(0)\n    WriteAt(0, 0, \"Taste A wählt\")\n    leere(1)\n    if Zug == 0:\n        ComputerStartete = True\n        Zug = 1\n        hatGesetzt = ECKE\n        e = 0\n        Ecke1 = Ecken[e]\n        Buche(Ecke1)\n        zeigeZelle(Ecke1)\n    else:\n        Brumme()\ninput.on_button_event(Button.AB, input.button_event_click(), on_button_ab)\n\ndef Strich(Zeile: number):\n    WriteAt(Zeile, 5, \"-\")\n    WriteAt(Zeile, 6, \"+\")\n    WriteAt(Zeile, 7, \"-\")\n    WriteAt(Zeile, 8, \"+\")\n    WriteAt(Zeile, 9, \"-\")\ndef B(j: number):\n    return Board[j]\ndef findeLetzteEcke():\n    global letzteEcke, i03, o, akt\n    letzteEcke = -1\n    i03 = 0\n    for k in range(4):\n        if B(E(k)) != 0:\n            i03 += 1\n    if i03 == 3:\n        m = 0\n        for n in range(4):\n            if B(E(n)) == 0:\n                o = E(n)\n        akt = E(m)\n        Buche(akt)\n        zeigeZelle(akt)\n    else:\n        pass\n\ndef on_button_b():\n    global blinke, hatGesetzt, Fertig, bl22, akt, Zug\n    leere(1)\n    if akt < 0 or Ende:\n        Brumme()\n    else:\n        blinke = False\n        Board[akt] = 4\n        zeigeZelle(akt)\n        if GameOver():\n            while True:\n                pass\n        if akt % 2 == 1:\n            hatGesetzt = RAND\n        else:\n            if akt == 4:\n                hatGesetzt = MITTE\n            else:\n                hatGesetzt = ECKE\n        Fertig = False\n        if ComputerStartete:\n            ComputerHatBegonnen()\n        else:\n            SpielerHatBegonnen()\n        if not (Fertig):\n            bl22 = SucheGabel()\n            if bl22 >= 0:\n                Buche(bl22)\n                zeigeZelle(bl22)\n            else:\n                if blockieren() < 0:\n                    if not (Fertig):\n                        if not (Angriff()):\n                            Zufall()\n        if GameOver():\n            while True:\n                blinke_Sieger()\n        akt = -1\n        Zug += 1\ninput.on_button_event(Button.B, input.button_event_click(), on_button_b)\n\ndef blinke_Sieger():\n    global i1\n    if Punkt != \" \":\n        for i0 in range(3):\n            i1 = Loesungen[bl32][i0]\n            ToKoord(i1)\n            WriteAt(zl_SCR, sp_SCR, Punkt)\n            if Punkt == \"X\":\n                led.plot_brightness(sp_LED, zl_LED, 30)\n            else:\n                led.plot_brightness(sp_LED, zl_LED, 255)\n        basic.pause(500)\n        for i02 in range(3):\n            i1 = Loesungen[bl32][i02]\n            ToKoord(i1)\n            WriteAt(zl_SCR, sp_SCR, \" \")\n            led.unplot(sp_LED, zl_LED)\n        basic.pause(100)\ndef init():\n    global Loesungen, Nachbarn3, Ecken3\n    Loesungen = [[0, 1, 2],\n        [3, 4, 5],\n        [6, 7, 8],\n        [0, 3, 6],\n        [1, 4, 7],\n        [2, 5, 8],\n        [0, 4, 8],\n        [2, 4, 6]]\n    Nachbarn3 = [1, 3, 4, 1, 4, 5, 3, 4, 7, 7, 4, 5]\n    Ecken3 = [2, 8, 6, 0, 6, 8, 0, 2, 8, 6, 0, 2]\ndef Angriff():\n    global i1\n    for bl2 in range(8):\n        if summe(bl2) == 8:\n            for sp2 in range(3):\n                i1 = Loesungen[bl2][sp2]\n                if B(i1) == 0:\n                    Buche(i1)\n                    zeigeZelle(i1)\n                    return True\n    return False\ndef Begruessung():\n    WriteAt(3, 2, \"Tic\")\n    basic.pause(500)\n    WriteAt(3, 7, \"Tac\")\n    basic.pause(500)\n    WriteAt(3, 12, \"Toe\")\n    basic.pause(2000)\n    oledssd1306.clear_display()\ndef Werte(Zeile2: number):\n    WriteAt(Zeile2, 6, \"|\")\n    WriteAt(Zeile2, 8, \"|\")\ndef SpielerHatBegonnen():\n    global Fertig\n    if Zug == 0:\n        if hatGesetzt == MITTE:\n            setzeAufErsteEcke()\n        else:\n            if hatGesetzt == ECKE:\n                setzeAufMitte()\n            else:\n                setzeAufMitte()\n        Fertig = True\n    else:\n        pass\ndef prev(wert2: number):\n    return wert2 - 1\ndef setzeAufMitte():\n    global akt\n    akt = 4\n    Buche(akt)\n    zeigeZelle(akt)\n    zeigeZelle(akt)\ndef GameOver():\n    global bl32, akt, Ende\n    for bl3 in range(8):\n        if summe(bl3) == 3:\n            WriteAt(0, 0, \"Calli hat     \")\n            WriteAt(1, 0, \"gewonnen\")\n            basic.set_led_colors(0x000000, 0x000000, 0xff0000, 20)\n            music.play(music.builtin_playable_sound_effect(soundExpression.sad),\n                music.PlaybackMode.UNTIL_DONE)\n            bl32 = bl3\n            akt = -1\n            Ende = True\n            return True\n        if summe(bl3) == 12:\n            WriteAt(0, 0, \"Du hast       \")\n            WriteAt(1, 0, \"gewonnen\")\n            basic.set_led_colors(0x000000, 0x00ff00, 0x000000, 20)\n            music._play_default_background(music.built_in_playable_melody(Melodies.WEDDING),\n                music.PlaybackMode.UNTIL_DONE)\n            bl32 = bl3\n            akt = -1\n            Ende = True\n            return True\n    if Board.index_of(0) == -1:\n        WriteAt(7, 0, \"Unentschieden  \")\n        basic.set_led_colors(0xffffff, 0x000000, 0x000000, 20)\n        music.play(music.builtin_playable_sound_effect(soundExpression.slide),\n            music.PlaybackMode.UNTIL_DONE)\n        bl32 = -1\n        Ende = True\n        return True\n    return False\ndef setzeAufErsteEcke():\n    global akt\n    akt = 8\n    Buche(akt)\n    zeigeZelle(akt)\n    zeigeZelle(akt)\ndef setzeAufEckeGegenueber():\n    global akt\n    akt = Diagonal[Ecke1]\n    Buche(akt)\n    zeigeZelle(akt)\ndef WriteAt(Zeile3: number, Spalte: number, Text: str):\n    oledssd1306.set_text_xy(Zeile3, Spalte)\n    oledssd1306.write_string(Text)\ndef summe(zl2: number):\n    global sum2, i1\n    sum2 = 0\n    for sp4 in range(3):\n        i1 = Loesungen[zl2][sp4]\n        sum2 = sum2 + B(i1)\n    return sum2\ndef SucheGabel():\n    global gefunden, e0, e_i, e_x, n_x\n    for e_1 in range(4):\n        gefunden = 0\n        e0 = Ecken[e_1]\n        # Ecke ist leer (Kandidat). Suche  mit X belegte Ecke\n        if B(e0) == 0:\n            for e_2 in range(3):\n                e_i = e_1 * 3\n                e_i = e_i + e_2\n                # Board-Position der mit X belegten Ecke\n                e_x = Ecken3[e_i]\n                if B(e_x) == 1:\n                    n_x = Nachbarn3[e_i]\n                    if B(n_x) == 0:\n                        gefunden += 1\n            if gefunden >= 2:\n                return e0\n    return -1\ndef loescheLED(nr7: number):\n    ToKoord(nr7)\n    led.unplot(sp_LED, zl_LED)\nn_x = 0\ne_x = 0\ne_i = 0\ne0 = 0\ngefunden = 0\nsum2 = 0\nEcken3: List[number] = []\nNachbarn3: List[number] = []\nbl32 = 0\nbl22 = 0\no = 0\ni03 = 0\nletzteEcke = 0\nEcke1 = 0\ne = 0\nhatGesetzt = 0\nblinke = False\ne2 = 0\nFertig = False\nsp_SCR = 0\nzl_SCR = 0\nLoesungen: List[List[number]] = []\ni1 = 0\nPunkt = \"\"\nRAND = 0\nMITTE = 0\nECKE = 0\nDiagonal: List[number] = []\nEcken: List[number] = []\nBoard: List[number] = []\nakt = 0\nsp_LED = 0\nzl_LED = 0\nZug = 0\nEnde = False\nComputerStartete = False\ne_22 = 0\ne_12 = 0\nComputerStartete = False\nEnde = False\nZug = 0\nzl_LED = 0\nsp_LED = 0\noledssd1306.init_display()\nBegruessung()\nzeigeFeld()\nakt = -1\nBoard = [0]\nfor Index22 